{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "target": "ES2023",
    "types": ["node", "vitest/globals"]
  },
  "include": ["prisma.config.ts", "scripts/**/*.ts", "src/**/*.ts", "test/**/*.ts"]
}
