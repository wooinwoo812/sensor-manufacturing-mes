generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  PRODUCTION_PLANNER
  MATERIAL_MANAGER
  SHOP_FLOOR_OPERATOR
  QUALITY_ENGINEER
  SYSTEM_ADMIN
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique @db.VarChar(254)
  displayName  String     @db.VarChar(100)
  passwordHash String     @db.VarChar(255)
  isActive     Boolean    @default(true)
  isDemo       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  roles        UserRole[]

  @@index([isDemo, isActive])
}

model Role {
  code  RoleCode   @id
  label String     @db.VarChar(50)
  users UserRole[]
}

model UserRole {
  userId   String
  roleCode RoleCode
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  sessions Session[]

  @@id([userId, roleCode])
  @@index([roleCode])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @db.Char(64)
  csrfToken  String    @db.VarChar(64)
  userId     String
  activeRole RoleCode
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userRole   UserRole  @relation(fields: [userId, activeRole], references: [userId, roleCode], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum WorkOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model WorkOrder {
  id              String            @id @default(cuid())
  orderNumber     String            @unique @db.VarChar(20)
  productCode     String            @db.VarChar(30)
  productName     String            @db.VarChar(100)
  plannedQuantity Int
  unit            String            @db.VarChar(10)
  dueDate         DateTime
  status          WorkOrderStatus   @default(DRAFT)
  priority        WorkOrderPriority @default(NORMAL)
  progressPercent Int               @default(0)
  currentStepName String?           @db.VarChar(60)
  blockedReason   String?           @db.VarChar(120)
  memo            String?           @db.VarChar(500)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  processSteps       ProcessStepExecution[]
  materialAllocations MaterialAllocation[]
  inspections        Inspection[]
  bomRevisionId      String?
  bomRevision        BomRevision?        @relation(fields: [bomRevisionId], references: [id], onDelete: SetNull)
  materialRequirements WorkOrderMaterialRequirement[]
  inspectionRequirements InspectionRequirement[]

  @@index([status, dueDate])
  @@index([dueDate])
}

enum QualityDisposition {
  PENDING
  ACCEPTED
  HOLD
  QUARANTINED
  REJECTED
}

model Material {
  id        String       @id @default(cuid())
  code      String       @unique @db.VarChar(30)
  name      String       @db.VarChar(100)
  unit      String       @db.VarChar(10)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lots      MaterialLot[]
  bomItems  BomItem[]
  workOrderRequirements WorkOrderMaterialRequirement[]
}

model MaterialLot {
  id                  String            @id @default(cuid())
  lotNumber           String            @unique @db.VarChar(24)
  materialId          String
  receivedQuantity    Int
  onHand              Int
  reservedQuantity    Int
  consumedQuantity    Int               @default(0)
  scrappedQuantity    Int               @default(0)
  qualityDisposition  QualityDisposition @default(PENDING)
  expiresAt           DateTime?
  receivedAt          DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  material            Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  allocations         MaterialAllocation[]
  traceNode           TraceNode?

  @@index([qualityDisposition, expiresAt])
  @@index([materialId])
}

enum ProcessReadiness {
  WAITING
  READY
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model ProcessStepExecution {
  id                 String          @id @default(cuid())
  workOrderId        String
  sequence           Int
  processStepName    String          @db.VarChar(60)
  productionLotNumber String         @db.VarChar(24)
  readiness          ProcessReadiness @default(WAITING)
  blockedReasonCodes String[]        @default([])
  startedAt          DateTime?
  completedAt        DateTime?
  goodQuantity       Int?
  defectQuantity     Int?
  executionMemo      String?         @db.VarChar(300)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  workOrder          WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([readiness])
  @@index([workOrderId, sequence])
  @@unique([workOrderId, sequence, productionLotNumber])
}

enum InspectionGate {
  ROUTE_ADVANCE
  LOT_COMPLETE
}

enum InspectionExecutionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionVerdict {
  PASS
  FAIL
  HOLD
}

model Inspection {
  id               String                    @id @default(cuid())
  inspectionNumber String                    @unique @db.VarChar(24)
  workOrderId      String
  productionLotNumber String                 @db.VarChar(24)
  processStepName  String                    @db.VarChar(60)
  gate             InspectionGate
  specName         String                    @db.VarChar(100)
  executionStatus  InspectionExecutionStatus @default(PENDING)
  verdict          InspectionVerdict?
  verdictMemo      String?                   @db.VarChar(300)
  completedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  workOrder        WorkOrder                 @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  decisions        InspectionDecision[]

  @@index([executionStatus, verdict])
  @@index([workOrderId])
}

model InspectionDecision {
  id           String            @id @default(cuid())
  inspectionId String
  sequence     Int
  phase        String            @db.VarChar(20)
  verdict      InspectionVerdict
  memo         String?           @db.VarChar(300)
  actorId      String?           @db.VarChar(64)
  actorName    String?           @db.VarChar(100)
  actorRole    RoleCode?
  occurredAt   DateTime          @default(now())
  inspection   Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, sequence])
}

enum AuditAction {
  USER_ACCESS_CHANGED
  SESSION_LOGIN
  SESSION_LOGOUT
  WORK_ORDER_CREATED
  WORK_ORDER_RELEASED
  WORK_ORDER_CANCELLED
  MATERIAL_RESERVED
  MATERIAL_RESERVATION_RELEASED
  MATERIAL_LOT_DISPOSITION_DECIDED
  PROCESS_STARTED
  PROCESS_COMPLETED
  INSPECTION_VERDICTED
  QUALITY_INCIDENT_REGISTERED
}

enum QualityIncidentStatus {
  OPEN
  ASSESSED
  CONTAINED
  CLOSED
}

enum QualityIncidentSourceType {
  MATERIAL_LOT
  PRODUCTION_LOT
  FINISHED_UNIT
}

model QualityIncident {
  id             String                    @id @default(cuid())
  incidentNumber String                    @unique @db.VarChar(24)
  title          String                    @db.VarChar(120)
  sourceType     QualityIncidentSourceType
  sourceLotNumber String                  @db.VarChar(24)
  description    String?                   @db.VarChar(500)
  status         QualityIncidentStatus    @default(OPEN)
  detectedAt     DateTime
  resolvedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, detectedAt])
  @@index([sourceType, sourceLotNumber])
}

model AuditEvent {
  id         String     @id @default(cuid())
  occurredAt DateTime
  actorId    String     @db.VarChar(64)
  actorRole  RoleCode
  actorName  String     @db.VarChar(100)
  action     AuditAction
  entityType String     @db.VarChar(40)
  entityId   String     @db.VarChar(64)
  summary    String     @db.VarChar(200)
  requestId  String     @db.VarChar(64)
  details    Json?
  createdAt  DateTime   @default(now())

  @@index([occurredAt])
  @@index([actorRole, action])
  @@index([entityType, entityId])
}

enum MaterialAllocationStatus {
  ACTIVE
  CLOSED
}

model MaterialAllocation {
  id           String                  @id @default(cuid())
  workOrderId  String
  materialLotId String
  quantity     Int
  status       MaterialAllocationStatus @default(ACTIVE)
  closedAt     DateTime?
  closedReason String?                 @db.VarChar(20)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  workOrder    WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  materialLot  MaterialLot             @relation(fields: [materialLotId], references: [id], onDelete: Restrict)

  @@index([workOrderId, status])
  @@index([materialLotId, status])
}

enum BomRevisionLifecycle {
  DRAFT
  PUBLISHED
  INACTIVE
}

model Product {
  id        String        @id @default(cuid())
  code      String        @unique @db.VarChar(30)
  name      String        @db.VarChar(100)
  baseUom   String        @db.VarChar(10)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bomRevisions BomRevision[]
}

model BomRevision {
  id              String              @id @default(cuid())
  revisionNumber  String              @unique @db.VarChar(24)
  productId       String
  description     String?             @db.VarChar(300)
  lifecycle       BomRevisionLifecycle @default(DRAFT)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  product         Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  items           BomItem[]
  workOrders      WorkOrder[]
  materialRequirements WorkOrderMaterialRequirement[]

  @@index([productId, lifecycle])
}

model BomItem {
  id                          String      @id @default(cuid())
  bomRevisionId               String
  materialId                  String
  quantityPerProductBaseUom   Decimal     @db.Decimal(18, 6)
  createdAt                   DateTime    @default(now())
  bomRevision                 BomRevision @relation(fields: [bomRevisionId], references: [id], onDelete: Cascade)
  material                    Material    @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([bomRevisionId, materialId])
  @@index([materialId])
}

model WorkOrderMaterialRequirement {
  id                          String      @id @default(cuid())
  workOrderId                 String
  bomRevisionId               String
  materialId                  String
  quantityPerProductBaseUom   Decimal     @db.Decimal(18, 6)
  requiredQuantity            Decimal     @db.Decimal(18, 6)
  unit                        String      @db.VarChar(10)
  createdAt                   DateTime    @default(now())
  workOrder                   WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  bomRevision                 BomRevision @relation(fields: [bomRevisionId], references: [id], onDelete: Restrict)
  material                    Material    @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([workOrderId, materialId])
  @@index([workOrderId])
}

enum InspectionSpecLifecycle {
  DRAFT
  PUBLISHED
  INACTIVE
}

model InspectionSpecRevision {
  id              String                    @id @default(cuid())
  revisionNumber  String                    @unique @db.VarChar(24)
  productCode     String                    @db.VarChar(30)
  specName        String                    @db.VarChar(100)
  gate            InspectionGate
  processStepName String?                   @db.VarChar(60)
  description     String?                   @db.VarChar(300)
  lifecycle       InspectionSpecLifecycle   @default(DRAFT)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  requirements    InspectionRequirement[]

  @@index([productCode, lifecycle])
}

model InspectionRequirement {
  id                        String                  @id @default(cuid())
  workOrderId               String
  inspectionSpecRevisionId  String
  specName                  String                  @db.VarChar(100)
  gate                      InspectionGate
  processStepName           String?                 @db.VarChar(60)
  createdAt                 DateTime                @default(now())
  workOrder                 WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inspectionSpecRevision    InspectionSpecRevision  @relation(fields: [inspectionSpecRevisionId], references: [id], onDelete: Restrict)

  @@unique([workOrderId, inspectionSpecRevisionId])
  @@index([workOrderId])
}

enum TraceNodeType {
  MATERIAL_LOT
  PRODUCTION_LOT
  FINISHED_UNIT
}

enum LotRelationType {
  CONSUME
  SPLIT
  MERGE
  TRANSFORM
  SERIALIZE
}

model TraceNode {
  id                  String        @id @default(cuid())
  nodeType            TraceNodeType
  label               String        @db.VarChar(24)
  materialLotId       String?       @unique
  productionLotNumber String?       @unique @db.VarChar(24)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  materialLot         MaterialLot?  @relation(fields: [materialLotId], references: [id], onDelete: Cascade)
  parentRelations     LotRelation[] @relation("LotRelationParent")
  childRelations      LotRelation[] @relation("LotRelationChild")

  @@index([nodeType, label])
}

model LotRelation {
  id                      String          @id @default(cuid())
  relationType            LotRelationType
  quantity                Int
  parentNodeId            String
  childNodeId             String
  processStepExecutionId  String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  parentNode              TraceNode       @relation("LotRelationParent", fields: [parentNodeId], references: [id], onDelete: Cascade)
  childNode               TraceNode       @relation("LotRelationChild", fields: [childNodeId], references: [id], onDelete: Cascade)

  @@unique([relationType, parentNodeId, childNodeId])
  @@index([childNodeId])
  @@index([parentNodeId])
}
